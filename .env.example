# ==============================================================================
#                 CONTENTOPS HARNESS - ENVIRONMENT CONFIGURATION MATRIX
# ==============================================================================

# Application Environment (production, staging, dev)
# Default is 'production' to enforce fail-closed security guarantees.
ENV=production
LOG_LEVEL=INFO
LOG_FORMAT=json

# ------------------------------------------------------------------------------
# Authentication & RBAC (Strict JWT with Key ID Rotation)
# ------------------------------------------------------------------------------
# Minimum 32 characters in production. Default development keys are rejected.
JWT_SECRET_KEY=change-me-to-a-secure-random-32-chars-jwt-secret-min
JWT_KEY_ID=jwt_v1
# Optional comma-separated rotation keys (format: kid:secret,kid2:secret2)
JWT_ROTATION_KEYS=
JWT_ALGORITHM=HS256
JWT_ISSUER=contentops-auth
JWT_AUDIENCE=contentops-api
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ------------------------------------------------------------------------------
# API Hardening, Reverse Proxy & Rate Limiting
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
MAX_REQUEST_BODY_SIZE_BYTES=1048576
RATE_LIMIT_GLOBAL=60/minute
# Trusted reverse proxy IPs (for X-Forwarded-For resolution)
TRUSTED_PROXIES=127.0.0.1,::1
TRUST_ALL_PROXIES=false
# Distributed Redis rate-limiting (optional, falls back safely to memory limiter)
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# Database & LangGraph State Persistence
# ------------------------------------------------------------------------------
DATABASE_URL=sqlite:///./contentops.db
# For production PostgreSQL / Supabase:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/contentops
CHECKPOINTER_TYPE=sqlite
# For production PostgreSQL LangGraph checkpointer:
# CHECKPOINTER_TYPE=postgres

# ------------------------------------------------------------------------------
# Google Gemini LLM Provider (via langchain-google-genai)
# Model ID: gemini-3.8-flash (official Google AI Studio / Vertex AI)
# ------------------------------------------------------------------------------
GOOGLE_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FAST_MODEL=gemini-3.8-flash
GEMINI_REASONING_MODEL=gemini-3.8-flash
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=3
LLM_CIRCUIT_BREAKER_THRESHOLD=3
LLM_CIRCUIT_BREAKER_RECOVERY=60.0

# Task Model Routing
LLM_MODEL_FOR_IDEATION=gemini-3.8-flash
LLM_MODEL_FOR_PRODUCTION=gemini-3.8-flash
LLM_MODEL_FOR_QA_JUDGE=gemini-3.8-flash
LLM_MODEL_FOR_STRATEGY=gemini-3.8-flash

# Deterministic LLM Cache & Pricing
LLM_CACHE_BACKEND=sqlite
LLM_CACHE_SQLITE_PATH=artifacts/cache/llm_cache.sqlite
LLM_CACHE_TTL_SECONDS=86400
PRICING_CONFIG_PATH=config/pricing.json

# ------------------------------------------------------------------------------
# Observability Integration (Langfuse)
# Tracing for cycles, spans, latency, token costs, QA scores and HITL feedback
# ------------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=pk-lf-your-langfuse-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-langfuse-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_TRACING_ENABLED=true

# ------------------------------------------------------------------------------
# Search & Research Connectors (Tavily)
# ------------------------------------------------------------------------------
TAVILY_API_KEY=tvly-your-tavily-key-here

# ------------------------------------------------------------------------------
# OAuth 2.0 Credentials (LinkedIn & X / Twitter)
# ------------------------------------------------------------------------------
# LinkedIn Developer Portal (Share on LinkedIn + Sign In with LinkedIn OpenID Connect)
# Required scopes: openid profile w_member_social
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:8000/v1/oauth/callback/linkedin
LINKEDIN_API_VERSION=202601

# X (Twitter) Developer Portal (OAuth 2.0 PKCE Confidential Client)
# Required scopes: tweet.read tweet.write users.read offline.access
X_CLIENT_ID=your_x_client_id
X_CLIENT_SECRET=your_x_client_secret
X_REDIRECT_URI=http://localhost:8000/v1/oauth/callback/x
X_MONTHLY_PUBLICATION_LIMIT=50

# ------------------------------------------------------------------------------
# OAuth Token Vault Encryption (AES-GCM Authenticated 256-bit with Key Ring)
# ------------------------------------------------------------------------------
# Master encryption key (>= 32 chars in production)
SECRET_VAULT_KEY=change-me-to-a-secure-random-32-chars-vault-master-key!
ACTIVE_VAULT_KEY_ID=v1
# Optional JSON key ring for seamless rotation: {"v1": "key1", "v2": "key2"}
SECRET_VAULT_KEY_RING=

# ------------------------------------------------------------------------------
# Social Publishing Governance & Safety Gates
# ------------------------------------------------------------------------------
# Forced sandbox by default. Set LIVE_PUBLISHING_ENABLED=true to dispatch real API calls.
SOCIAL_SANDBOX_MODE=true
LIVE_PUBLISHING_ENABLED=false
LIVE_TESTS=0

# Emergency Kill-Switch (true halts all outgoing publications immediately)
KILL_SWITCH_GLOBAL=false
MAX_PUBLICATIONS_PER_HOUR=10
PUBLISHER_POLL_INTERVAL_SECONDS=10
PUBLISHER_MAX_RETRIES=3
DEFAULT_TIMEZONE=UTC

# AI Transparency Rule: "disabled" | "editorial" (default, human gate) | "mandatory"
AI_TRANSPARENCY_MODE=editorial

