# ==============================================================================
#                 CONTENTOPS HARNESS - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-super-secret-key-32-chars-minimum

# Database (PostgreSQL / Supabase or local SQLite fallback)
# Example for Supabase/PostgreSQL:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/contentops
DATABASE_URL=sqlite+aiosqlite:///./contentops.db

# ------------------------------------------------------------------------------
# Google Gemini LLM Provider (via langchain-google-genai)
# ------------------------------------------------------------------------------
GOOGLE_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FAST_MODEL=gemini-3.8-flash
GEMINI_REASONING_MODEL=gemini-3.8-flash

# ------------------------------------------------------------------------------
# Observability Integration (Langfuse)
# Tracing for cycles, spans, latency, token costs, QA scores and HITL feedback
# ------------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=pk-lf-your-langfuse-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-langfuse-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_TRACING_ENABLED=true

# ------------------------------------------------------------------------------
# Search & Research Connectors (Tavily)
# ------------------------------------------------------------------------------
TAVILY_API_KEY=tvly-your-tavily-key-here

# ------------------------------------------------------------------------------
# Social Platform Connectors (Sandbox / Production)
# ------------------------------------------------------------------------------
SOCIAL_SANDBOX_MODE=true
LINKEDIN_CLIENT_ID=mock_linkedin_client_id
LINKEDIN_CLIENT_SECRET=mock_linkedin_client_secret
LINKEDIN_ACCESS_TOKEN=mock_linkedin_token
X_API_KEY=mock_x_api_key
X_API_SECRET=mock_x_api_secret
X_ACCESS_TOKEN=mock_x_token

# ------------------------------------------------------------------------------
# Publisher & Scheduler Settings
# ------------------------------------------------------------------------------
PUBLISHER_POLL_INTERVAL_SECONDS=10
PUBLISHER_MAX_RETRIES=3
DEFAULT_TIMEZONE=UTC
